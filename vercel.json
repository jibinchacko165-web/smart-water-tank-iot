{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vegetarian-star-lips-edited.trycloudflare.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://vegetarian-star-lips-edited.trycloudflare.com/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://vegetarian-star-lips-edited.trycloudflare.com/health/"
    },
    {
      "source": "/((?!api|assets|favicon|health).*)",
      "destination": "/index.html"
    }
  ]
}
